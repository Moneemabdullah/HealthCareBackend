
# Environment variables for the application
NODE_ENV=development
PORT=your_port_here

# Database connection string for Prisma
DATABASE_URL=""

# Better Auth secrets and configurations
BETTER_AUTH_SECRET=a_secure_random_string_here
BETTER_AUTH_URL=http://localhost:your_port_here # Base URL of your app

# JWT secrets and configurations
ACCESS_TOKEN_SECRET=a_secure_random_string_here
REFRESH_TOKEN_SECRET=a_secure_random_string_here
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=1d
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=7d


#smtp environment variables
EMAIL_SENDER_SMTP_HOST=google.smtp.com
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_SMTP_USER=your_email_here
EMAIL_SENDER_SMTP_PASS=a_secure_random_string_here
EMAIL_SENDER_FROM=HealthCare App <your_email_here>

#google oauth environment variables
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
